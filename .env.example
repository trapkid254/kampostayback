# KampoStay API — Environment Variables
# Copy to .env and fill in values

# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_NAME=KampoStay
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# ── Database (MongoDB Atlas) ────────────────────────────
# Production: mongodb+srv://user:pass@cluster.mongodb.net/kampostay
MONGODB_URI=mongodb://127.0.0.1:27017/kampostay

# ── JWT Authentication ──────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_ROUNDS=12
COOKIE_SECRET=change-me-cookie-secret

# ── Email (SMTP) — console fallback if empty ────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@kampostay.co.ke

# ── Cloudinary (media uploads) — placeholder if empty ───
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── M-Pesa Daraja (Safaricom) ───────────────────────────
# Leave empty for sandbox auto-complete mode
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-app.onrender.com/api/v1/payments/mpesa/callback
MPESA_ENV=sandbox

# ── AI (optional — rule-based works without key) ────────
OPENAI_API_KEY=

# ── Security ────────────────────────────────────────────
CSRF_ENABLED=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Seed Data ───────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@kampostay.co.ke
SEED_ADMIN_PASSWORD=Admin@12345

# ── Render.com Deployment Notes ─────────────────────────
# 1. Create a Web Service pointing to backend/ directory
# 2. Build command: npm install
# 3. Start command: npm start
# 4. Add env vars above in Render dashboard
# 5. Use MongoDB Atlas connection string for MONGODB_URI
# 6. Set MPESA_CALLBACK_URL to your Render URL + /api/v1/payments/mpesa/callback
# 7. Run seed once: npm run seed (via Render shell or locally against Atlas)
